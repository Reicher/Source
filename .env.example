# Source Node is LAN-only. Keep the safe loopback default until the target
# host's reserved LAN address has been verified.
SOURCE_BIND_IP=127.0.0.1
SOURCE_GATEWAY_HOST=127.0.0.1
SOURCE_HTTPS_PORT=8443
# Published on 127.0.0.1 only; this value changes the host port, not the boundary.
SOURCE_ADMIN_PORT=9090
SOURCE_DATA_ROOT=./data
SOURCE_UID=1000
SOURCE_GID=1000

# Source API limits.
SOURCE_SNAPSHOT_MAX_MIB=32
SOURCE_SNAPSHOT_RETENTION_COUNT=20
SOURCE_LIBRARY_ITEM_MAX_MIB=2048
SOURCE_ALLOWED_STORAGE_APPS=thoughts,source-client,source-library
SOURCE_PAIRING_INVITATION_TTL_SECONDS=300
SOURCE_ADMIN_SESSION_TTL_SECONDS=28800

# Source AI routing and request policy.
SOURCE_AI_MODEL=source-qwen3.5-9b
SOURCE_AI_MAX_OUTPUT_TOKENS=2048
SOURCE_AI_TIMEOUT_SECONDS=300

# llama.cpp runtime. Provision the pinned GGUF explicitly before starting normal runtime.
LLAMA_MODEL_FILE=Qwen_Qwen3.5-9B-Q5_K_M.gguf
LLAMA_MEMORY_LIMIT=16g
LLAMA_CONTEXT_TOKENS=8192
LLAMA_THREADS=8
