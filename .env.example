# Source Node is LAN-only. Keep the safe loopback default until the target
# host's reserved LAN address has been verified.
SOURCE_BIND_IP=127.0.0.1
SOURCE_GATEWAY_HOST=127.0.0.1
SOURCE_HTTPS_PORT=8443
# Published on 127.0.0.1 only; this value changes the host port, not the boundary.
SOURCE_ADMIN_PORT=9090
SOURCE_DATA_ROOT=./data
SOURCE_UID=1000
SOURCE_GID=1000

# Source API limits.
MAX_SNAPSHOT_MIB=32
SNAPSHOT_RETENTION_COUNT=20
ALLOWED_STORAGE_APPS=thoughts
PAIRING_INVITATION_TTL_SECONDS=300
ADMIN_SESSION_TTL_SECONDS=28800

# Local model. Provision it explicitly before starting normal runtime.
OLLAMA_IMAGE=ollama/ollama:0.33.3
OLLAMA_MODEL=qwen3:4b
OLLAMA_MEMORY_LIMIT=10g
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=120
